<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ScamBusterAI V9 - Dashboard</title>
<style>
body{background:#0b1220;color:white;font-family:Arial;padding:15px;margin:0}
.header{display:flex;justify-content:space-between;align-items:center}
.live{background:#00e676;color:#000;padding:5px 12px;border-radius:20px;font-weight:bold}
.cards{display:flex;gap:10px;margin:15px 0}
.card{background:#16213e;padding:15px;border-radius:12px;flex:1;text-align:center}
.card b{font-size:28px;display:block}
table{width:100%;background:#16213e;border-radius:12px;border-collapse:collapse;overflow:hidden}
th,td{padding:10px;text-align:left;font-size:13px;border-bottom:1px solid #2a3a5f}
.scam{color:#ff5252;font-weight:bold}
.sain{color:#00e676;font-weight:bold}
</style>
</head>
<body>
<div class="header"><h2>🛡️ ScamBusterAI V9</h2><span class="live">● LIVE</span></div>
<p>AUTONOMOUS AI - SANS INTERVENTION HUMAINE</p>
<div class="cards">
<div class="card"><b id="patterns">6</b>Patterns Appris</div>
<div class="card"><b id="blocked">2</b>Total Bloqué</div>
<div class="card"><b id="checked">6</b>Total Vérifié</div>
</div>
<h3>Décisions récentes</h3>
<table>
<tr><th>Message</th><th>Verdict</th><th>Score</th></tr>
<tr><td>Orange Money Yebela Cash 10 millions FC</td><td class="scam">SCAM</td><td>85/100</td></tr>
<tr><td>Orange Money paris Mbet, Mojabet</td><td class="sain">SAIN</td><td>25/100</td></tr>
<tr><td>FELICITATION Depannage 23,100 CDF *144#6#</td><td class="scam">SCAM</td><td>97/100</td></tr>
<tr><td>SUPAPESA Fitness *1435*4*2#</td><td class="sain">SAIN</td><td>20/100</td></tr>
<tr><td>Retrait M-Pesa Rawbank N°34376</td><td class="sain">SAIN</td><td>15/100</td></tr>
<tr><td>Compte crédité CDF 5,000 SAB</td><td class="sain">SAIN</td><td>10/100</td></tr>
</table>
<p id="api" style="margin-top:15px;color:#aaa">Connexion à l'API...</p>
<script>
fetch('https://scambusterai-empire-v7.onrender.com/')
.then(r=>r.json()).then(d=>{
document.getElementById('api').innerText='API Connectée : '+(d.status||'LIVE');
if(d.learned_patterns!==undefined) document.getElementById('patterns').innerText=d.learned_patterns;
if(d.total_blocked!==undefined) document.getElementById('blocked').innerText=d.total_blocked;
if(d.total_checked!==undefined) document.getElementById('checked').innerText=d.total_checked;
}).catch(()=>{document.getElementById('api').innerText='API en veille - chiffres de test affichés';});
</script>
</body>
</html>
